# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=support_desk

# App
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d

# CORS
CORS_ORIGIN=http://localhost:3000
RESEND_API_KEY=...                       (password reset ke liye pehle se hai)
FRONTEND_URL=https://trydeskly.vercel.app   (email ke link ke liye)
EMAIL_FROM=Deskly <aap@aap-ka-domain>        (optional)